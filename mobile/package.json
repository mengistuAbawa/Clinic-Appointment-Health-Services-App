{
  "name": "clinic-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node \"../node_modules/expo/bin/cli\" start",
    "android": "node \"../node_modules/expo/bin/cli\" start --android",
    "ios": "node \"../node_modules/expo/bin/cli\" start --ios",
    "web": "node \"../node_modules/expo/bin/cli\" start --web",
    "lint": "node \"../node_modules/typescript/bin/tsc\" --noEmit",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:production": "npx eas-cli build --platform android --profile production"
  },
  "dependencies": {
    "expo": "~58.0.14",
    "expo-router": "~58.0.20",
    "expo-status-bar": "~58.0.2",
    "expo-dev-client": "~58.0.2",
    "expo-secure-store": "~58.0.2",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-image-picker": "~58.0.10",
    "expo-image": "~58.0.9",
    "expo-constants": "~58.0.4",
    "expo-linking": "~58.0.4",
    "expo-splash-screen": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.30.0",
    "react-native-maps": "^1.29.0",
    "react-native-web": "0.21.0",
