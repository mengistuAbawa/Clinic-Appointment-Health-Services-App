{
  "name": "clinic-appointment-backend",
  "version": "1.0.0",
  "description": "Clinic Appointment & Health Services API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../node_modules/nodemon/bin/nodemon.js",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "seed": "node ../node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "migrate": "node ../node_modules/prisma/build/index.js migrate dev",
    "studio": "node ../node_modules/prisma/build/index.js studio",
    "generate": "node ../node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
